# Desarrollo local: NO pegar secretos reales en el repositorio.
DATABASE_URL=postgresql://tokentiva:change-me@localhost:5432/tokentiva
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-cryptographically-random-secret-32-plus-chars
# Modo de bootstrap local temporal; SIEMPRE desactivado en despliegues.
TOKENTIVA_SIGNUP_ENABLED=false
NEXT_PUBLIC_TOKENTIVA_SIGNUP_ENABLED=false
# Email verificado obligatorio. Configurar SMTP real antes de dar de alta usuarios.
TOKENTIVA_SMTP_HOST=
TOKENTIVA_SMTP_PORT=465
TOKENTIVA_SMTP_USER=
TOKENTIVA_SMTP_PASSWORD=
TOKENTIVA_SMTP_FROM=

# F1d documentos. OFF por defecto; no activar hasta staging verificado.
TOKENTIVA_DOCUMENT_UPLOADS_ENABLED=false
# openssl rand -base64 32  # guardar fuera del repositorio y hacer backup del secreto
TOKENTIVA_DOCS_KEY_B64=
# ClamAV disponible SOLO en loopback o red interna. Nunca exponer TCP 3310 públicamente.
TOKENTIVA_CLAMD_HOST=
TOKENTIVA_CLAMD_PORT=3310
