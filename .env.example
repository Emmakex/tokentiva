# Ejemplo local; nunca subir valores reales.
DATABASE_URL=postgresql://tokentiva:change-me@localhost:5432/tokentiva
BETTER_AUTH_URL=http://localhost:3000
# Genera un secreto criptográfico aleatorio largo (mínimo 32 caracteres).
BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
# Mantener desactivado salvo bootstrap controlado; volver a false después.
TOKENTIVA_SIGNUP_ENABLED=false
NEXT_PUBLIC_TOKENTIVA_SIGNUP_ENABLED=false
