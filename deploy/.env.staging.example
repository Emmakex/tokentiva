# Copiar a deploy/.env.staging y completar en el servidor, no en Git.
# Solo caracteres hexadecimales para passwords DB (evita problemas de URL encoding).
TOKENTIVA_STAGING_DOMAIN=staging.example.invalid
TOKENTIVA_DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_HEX_48
TOKENTIVA_DB_APP_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_HEX_48
BETTER_AUTH_SECRET=CHANGE_ME_BASE64_OR_HEX_32_PLUS
TOKENTIVA_SMTP_HOST=mail.example.invalid
TOKENTIVA_SMTP_PORT=465
TOKENTIVA_SMTP_USER=staging@example.invalid
TOKENTIVA_SMTP_PASSWORD=CHANGE_ME
TOKENTIVA_SMTP_FROM="Tokentiva Staging <staging@example.invalid>"
TOKENTIVA_DOCS_KEY_B64=CHANGE_ME_RANDOM_BASE64_32_BYTES
TOKENTIVA_DOCUMENT_UPLOADS_ENABLED=false
# Para backup con age: clave pública del destinatario, sin clave privada en host web.
TOKENTIVA_BACKUP_AGE_RECIPIENT=age1REPLACE_ME
